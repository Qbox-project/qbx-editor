{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [["[", "]"]],
  "autoClosingPairs": [
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "[", "close": "]" }
  ],
  "surroundingPairs": [
    ["\"", "\""],
    ["[", "]"]
  ],
  "wordPattern": "[A-Za-z0-9_.:\\-\\[\\]]+"
}
