          "contentName": "meta.embedded.block.sql",
          "patterns": [
            {
              "include": "#sql-in-double"
            }
          ]
        },
        {
          "begin": "(?<!--)\\[(=*)\\[",
          "beginCaptures": {
            "0": {
              "name": "string.quoted.other.multiline.lua punctuation.definition.string.begin.lua"
            }
